#!/bin/sh
# Only PATH should change before overlay captures the caller's environment.
ensure_path() {
    case ":$PATH:" in
        *:"$1":*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

PATH=${PATH:-/bin}
ensure_path /bin
ensure_path /usr/bin
ensure_path /command

# Insert the with-contenv shim before /command, retaining other path entries.
PATH=:${PATH}:
PATH="${PATH%%:/command:*}:/usr/libexec/superng6/compat-bin:/command:${PATH#*:/command:}"
PATH=${PATH#:}
export PATH="${PATH%:}"
exec /usr/libexec/superng6/overlay-init "$@"
