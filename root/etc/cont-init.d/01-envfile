#!/usr/bin/with-contenv bash

shopt -s nullglob

for FILENAME in /run/s6/container_environment/FILE__*; do
    SECRETFILE="$(cat "${FILENAME}")"
    if [[ -f "${SECRETFILE}" ]]; then
        name=${FILENAME##*/}
        FILESTRIP="${FILENAME%/*}/${name#FILE__}"
        # The overlay's s6-envdir -Lf consumes one terminating newline.
        # A newline alone encodes a present, empty environment variable.
        if { cat -- "${SECRETFILE}" && printf '\n'; } >"${FILESTRIP}"; then
            echo "[env-init] ${FILESTRIP##*/} set from ${FILENAME##*/}"
        else
            echo "[env-init] cannot import ${FILENAME##*/}" >&2
        fi
    else
        echo "[env-init] cannot find secret in ${FILENAME##*/}"
    fi
done
