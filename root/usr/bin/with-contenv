#!/bin/bash

# s6-supervise starts run and finish in the service directory. Compare
# directories by inode since /run/service entries can be symbolic links.
# Legacy init and native oneshots inherit the internal oneshot runner's cwd.
if [[ -f /run/s6/container_environment/UMASK && ! . -ef /run/service/s6rc-oneshot-runner ]]; then
    cwd=$(pwd -P)
    name=${cwd##*/}
    parent=${cwd%/*}
    if [[ . -ef /run/service/$name || . -ef /run/service/${parent##*/}/log ]]; then
        umask "$(</run/s6/container_environment/UMASK)"
    fi
fi

exec /command/with-contenv "$@"
